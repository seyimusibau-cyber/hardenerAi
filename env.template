# =============================================================================
# Vultix web app (Vercel) — environment
# =============================================================================
#   cp env.template .env.local     # .env.local is gitignored, never commit it
#
# In production these go in the Vercel dashboard, not in a file.
#
# The scanner lives in its own repo and deploys to Render. Everything it needs
# is in that repo's .env.example; the two are joined by SCANNER_URL and two
# shared secrets, marked MUST MATCH below.
#
# Only NEXT_PUBLIC_* variables reach the browser. Everything else is server-only.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — REQUIRED
# -----------------------------------------------------------------------------
# The app fails fast at request time without these three (see src/lib/env.ts).
# The anon key is public by design; RLS is what protects the data, because the
# dashboard pages query Supabase directly from the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role. Bypasses RLS. Server-only, never expose it to the browser.
# The scanner repo calls this same value SUPABASE_SERVICE_KEY.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# App — REQUIRED
# -----------------------------------------------------------------------------
# Your deployed URL, no trailing slash. Used to build callback URLs, so a wrong
# value breaks the scanner's completion webhook silently.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development


# =============================================================================
# THE SCANNER BACKEND (Render)
# =============================================================================

# Which runner executes a queued scan. `none` fails the scan loudly rather than
# leaving it Running forever — see the header of src/lib/runner.ts.
#
#   service   the Render service below (what you want in production)
#   github    workflow_dispatch on scan.yml — free, no extra infra
#   fly       ephemeral Fly machine
#   none      no runner; scans fail with a clear message
#
# Left unset, the runner is inferred from whichever secrets are present,
# preferring `service`. Set it explicitly so a deploy cannot drift.
RUNNER=service

# --- RUNNER=service ----------------------------------------------------------
# The Render service URL, no trailing slash. e.g. https://vultix-scanner.onrender.com
SCANNER_URL=

# MUST MATCH `SCANNER_SHARED_SECRET` in the scanner repo, byte for byte.
# The app signs `${timestamp}.${body}` with this; the scanner rejects anything
# that does not verify, so a mismatch shows up as every scan 401ing.
#   generate: openssl rand -hex 32
SCANNER_SHARED_SECRET=

# MUST MATCH `NOTIFY_SECRET` in the scanner repo. Authenticates the scanner's
# callback to /api/webhooks/notify when a scan finishes.
NOTIFY_SECRET=

# --- RUNNER=github (free alternative) ----------------------------------------
# A PAT with `actions:write` on the repo holding .github/workflows/scan.yml.
# GITHUB_RUNNER_TOKEN=
# GITHUB_RUNNER_REPO=owner/repo
# GITHUB_RUNNER_WORKFLOW=scan.yml
# GITHUB_RUNNER_REF=main

# --- RUNNER=fly --------------------------------------------------------------
# FLY_API_TOKEN=
# FLY_APP_NAME=vultix-scanner
# FLY_SCANNER_IMAGE=registry.fly.io/vultix-scanner:latest


# =============================================================================
# AI verifier
# =============================================================================
# The web app runs its own Gemini pass (src/lib/gemini-verifier.ts) separately
# from the scanner's. Both need a key; they can be the same one.
GEMINI_API_KEY=

# Pin the model. The hardcoded fallback is gemini-2.5-flash, which Google
# retired in Aug 2026 and now 404s for new keys — unset means broken, not default.
# Keep this identical to GEMINI_MODEL in the scanner repo or the two layers
# disagree about what they are measuring.
GEMINI_MODEL=gemini-3.7-flash

# Abort a verify call that hangs, in ms.
GEMINI_TIMEOUT_MS=30000


# =============================================================================
# Queue — Upstash QStash
# =============================================================================
# Delivers queued scans to /api/webhooks/qstash with retries. Required by
# src/lib/env.ts wherever the queue is used.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=


# =============================================================================
# Billing — Stripe
# =============================================================================
# NOTE: /api/checkout has no caller in the app today. Set these when the pricing
# page is wired to it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# =============================================================================
# Pull requests
# =============================================================================
# A PAT that opens PRs with an accepted patch. Scope it as tightly as GitHub
# allows: this token can write to whatever PR_ALLOWED_REPOS names.
GITHUB_TOKEN=

# Allowlist for /api/pr, comma-separated `owner/repo`. An EMPTY VALUE MEANS NO
# REPO IS ALLOWED, which is the safe default — fill it in deliberately.
PR_ALLOWED_REPOS=


# =============================================================================
# Transactional Email & Deliverability (Resend)
# =============================================================================
# RESEND_API_KEY: Used for password reset recovery emails and security alerts.
# Completely eliminates Supabase free-tier's 3-emails/hour rate limit and ensures
# 99%+ deliverability when paired with verified domain DNS records (SPF, DKIM, DMARC).
RESEND_API_KEY=
ALERT_FROM_EMAIL=Vultix Security <security@vultix.co.uk>
EMAIL_FROM=Vultix Security <security@vultix.co.uk>
SLACK_WEBHOOK_URL=


# =============================================================================
# Two-factor authentication
# =============================================================================
TWO_FACTOR_APP_NAME=Vultix
TWO_FACTOR_BACKUP_CODES_COUNT=10
