# Worker env. For a LOCAL dry run you only need GEMINI_API_KEY + TARGET_URL:
#   npm install
#   GEMINI_API_KEY=... TARGET_URL=https://github.com/owner/repo npm run scan:local
# (DRY_RUN prints findings as JSON; no Supabase/Fly required.)
GEMINI_API_KEY=
TARGET_URL=

# Production (set as Fly secrets, not here):
# SCAN_ID=            # per-scan, passed by the webhook
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# APP_URL=
# NOTIFY_SECRET=
# MAX_FINDINGS=25
# SCAN_TIMEOUT_MS=1500000
# GEMINI_MODEL=gemini-2.5-flash
